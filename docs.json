{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Voyager",
  "description": "Documentation for the Voyager Shopify theme — editorial fashion theme for considered brands.",
  "colors": {
    "primary": "#002F5B",
    "light": "#C39738",
    "dark": "#002F5B"
  },
  "favicon": "/favicon.svg",
