            "pages": [
              "troubleshooting/common-issues",
              "troubleshooting/faq",
              "troubleshooting/performance-and-accessibility",
              "troubleshooting/internationalization",
              "troubleshooting/support-and-changelog",
              "support"
            ]
          }
